[Unit]
Description=Alfred Privacy-First AI Assistant Daemon
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=alfred
WorkingDirectory=/opt/alfred
ExecStart=/usr/bin/env python3 -m src.main --host 0.0.0.0 --port 8020 --lang de
Restart=on-failure
RestartSec=5
Environment=ALFRED_DEFAULT_LANGUAGE=de
Environment=ALFRED_PASSPHRASE_BASE=Nilpferd

[Install]
WantedBy=multi-user.target

