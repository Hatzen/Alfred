# =============================================================================
# Alfred AI Assistant — Environment Template
# Copy to `.env` and adjust URLs/models for your host (LocalAI / Ollama / Spark)
# =============================================================================

ALFRED_NAME=Alfred
ALFRED_SIMULATION=false
ALFRED_HOST=0.0.0.0
ALFRED_PORT=8020
ALFRED_DB_PATH=data/alfred_memory.db

ALFRED_DEFAULT_LANGUAGE=de
ALFRED_WAKE_WORDS=hey alfred,alfred,hey alexa,hey google,hallo alfred
ALFRED_INTERRUPT_PHRASES=stop,forget it,cancel,nevermind,never mind,stopp,vergiss es,abbrechen,ruhe,halt
ALFRED_FOLLOW_UP_SECONDS=15.0
ALFRED_PASSPHRASE_BASE=Nilpferd

# LocalAI (Chat, STT, TTS, VAD)
ALFRED_LOCALAI_URL=http://localhost:8080/v1
ALFRED_LOCALAI_API_KEY=local-no-key-required
ALFRED_CHAT_MODEL=hermes-3-llama-3.1-8b
ALFRED_STT_MODEL=whisper-large-v3-turbo
ALFRED_TTS_MODEL=piper-de-thorsten
ALFRED_TTS_VOICE=de-DE-thorsten-high
ALFRED_VAD_MODEL=silero-vad

# Ollama Fallback
ALFRED_OLLAMA_URL=http://localhost:11434
ALFRED_OLLAMA_MODEL=qwen3.5:4b

# Audio & Low-CPU Listening
ALFRED_SMART_AUDIO=true
ALFRED_IDLE_POLL_MS=40

# External Services
ALFRED_FANCYTANKY_URL=http://localhost:8000
ALFRED_PAPERLESS_URL=http://localhost:8010
ALFRED_PAPERLESS_TOKEN=
ALFRED_HERMES_ENABLED=true
ALFRED_HERMES_MQTT_HOST=localhost
ALFRED_HERMES_MQTT_PORT=1883

